# --- 必須 ---------------------------------------------------------------
# 管理者用(/admin と /api/admin)のトークン。長いランダム値にすること:  openssl rand -hex 32
ADMIN_TOKEN=change-me

# --- 利用者のログイン (GitHub OAuth) ---------------------------------------------
# 3つそろわないと、利用者はログインできない。
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App で作る:
#   Homepage URL                : https://devbox.clusters-prj.com
#   Authorization callback URL  : https://devbox.clusters-prj.com/auth/github/callback
# 作ったあとに Client ID と、Generate a new client secret で出した Client secret を書く。
PUBLIC_URL=https://devbox.clusters-prj.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 新しく登録した人は「承認待ち」になり、管理画面(/admin/)で承認するまで使えない。
# DEFAULT_MAX_PROJECTS=3             # 1人が作れるプロジェクト数(管理画面から人ごとに変えられる)
# DEFAULT_MAX_RUNNING_PER_USER=1     # 1人が同時に動かせる数(ビルド中・待機中も含む)
# SESSION_DAYS=14                    # ログインの有効期間

# --- プレビューURL -------------------------------------------------------
# devbox 管理画面のホスト名 (Traefik が振り分ける)
DEVBOX_HOST=devbox.clusters-prj.com
# 開発コンテナのURL。{id} が置換される。
# Cloudflare 無料の Universal SSL は「*.clusters-prj.com」(1階層)のみ対応なので、
# サブドメインを深くせず「{id}-dev.clusters-prj.com」の形にする。
PREVIEW_HOST_TEMPLATE={id}-dev.clusters-prj.com
PREVIEW_SCHEME=https
# PREVIEW_PORT=8080          # LAN内で http のまま :8080 で見るとき、プレビューURLに付けるポート

# --- 任意 ----------------------------------------------------------------
# SECRET_KEY=                 # env暗号化キー(64桁hex)。未設定なら data/secret.key に自動生成
# ALLOWED_GIT_HOSTS=github.com,gitlab.com,bitbucket.org
# LIMIT_MEMORY_MB=512
# LIMIT_CPUS=1
# LIMIT_PIDS=256
# MAX_PROJECTS=200                   # サーバー全体のプロジェクト数の上限(利用者ごとの上限とは別)
# MAX_CONCURRENT_BUILDS=2
# MAX_REPO_MB=300
# DOCKER_RUNTIME=runsc        # gVisor を入れた場合
# TRAEFIK_BIND=127.0.0.1      # Traefik を公開するIP。Cloudflare Tunnel が別ホスト(dell)にいるなら DockerV のIP(例: 10.2.2.1)にする
# TRAEFIK_PORT=8080           # ホスト側に公開するポート

# --- 同時稼働数・自動停止 ---------------------------------------------------
# MAX_RUNNING=30              # ビルド中+実行中の上限。超えたら「待機中」になり、空いた順に起動
# MAX_RUNTIME_HOURS=8         # 起動からこの時間で自動停止(0または未設定なら無効)
# IDLE_STOP_MINUTES=60        # 無操作(プレビューへのアクセスなし)がこの分数続いたら自動停止(既定60、0で無効)

# --- プレビューのDNS自動作成 (3つ全部そろったときだけ有効) -----------------
# 起動時に {id}-dev.… の CNAME を作り、停止/削除で消す。devbox が作った印(comment)のあるレコードしか消さない。
# CF_API_TOKEN=               # 権限は「対象ゾーンの DNS:編集」だけにする
# CF_ZONE_ID=                 # clusters-prj.com のゾーンID
# DNS_TARGET=                 # <プレビュー専用トンネルのUUID>.cfargotunnel.com
